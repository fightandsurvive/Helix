# ══════════════════════════════════════════════════════════════════
# Helix runtime configuration
# Copy to .env and edit. NEVER commit .env.
# ══════════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://trin:trin_dev@localhost:5432/helix_db
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── Compute ──────────────────────────────────────────────────────
# Blackwell headless GPU index (0 = A2000 display, 1 = PRO 5000 compute)
CUDA_VISIBLE_DEVICES=1
TORCH_DTYPE=bfloat16

# NVFP4 training — enabled by default; falls back to BF16 if hardware
# is not Blackwell or torchao is missing. Set to false to force BF16.
USE_NVFP4=true

# ── Paths ────────────────────────────────────────────────────────
SYZYGY_PATH=~/syzygy
STOCKFISH_PATH=~/bin/stockfish-17.1
CHECKPOINTS_DIR=./checkpoints

# ── External services ────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:32b

# ── Observability ────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true
